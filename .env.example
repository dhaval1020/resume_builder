NODE_ENV=production
API_PORT=3001
JWT_SECRET=replace-with-a-strong-random-secret
ALLOWED_ORIGINS=https://your-frontend-domain.com

# CCAvenue (server-side)
CCAVENUE_MERCHANT_ID=xxxxxxxx
CCAVENUE_ACCESS_CODE=xxxxxxxx
CCAVENUE_WORKING_KEY=xxxxxxxx
CCAVENUE_ENV=sandbox
# Optional explicit URL override:
# CCAVENUE_PAYMENT_URL=https://test.ccavenue.com/transaction/transaction.do?command=initiateTransaction

# Optional frontend keys
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=

# Google Sign-In (required for /api/auth/google)
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=
